{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SlimWojak/aura/research/cartridges/cartridge.schema.json",
  "title": "Aura research cartridge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "thesis",
    "symbol",
    "tf",
    "baseline_ref",
    "ichimoku",
    "entry_rules",
    "exit_rules",
    "regime",
    "kill_criteria",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "queued", "tested", "killed", "kept"]
    },
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "default": "PF_XBTUSD"
    },
    "tf": {
      "type": "string",
      "default": "1h"
    },
    "baseline_ref": {
      "type": "string",
      "default": "ichimoku_v0"
    },
    "ichimoku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenkan", "kijun", "senkou_b", "displacement"],
      "properties": {
        "tenkan": {"type": "integer", "minimum": 1},
        "kijun": {"type": "integer", "minimum": 1},
        "senkou_b": {"type": "integer", "minimum": 1},
        "displacement": {"type": "integer", "minimum": 1}
      }
    },
    "entry_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed_sides",
        "require_close_vs_cloud",
        "require_tk_state",
        "require_chikou_confirmation",
        "chikou_mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "always_on",
            "tk_cross",
            "cloud_bias",
            "tk_cloud_bias",
            "kijun_bounce",
            "tenkan_bounce",
            "kumo_break"
          ]
        },
        "allowed_sides": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["long", "short"]}
        },
        "require_close_vs_cloud": {
          "enum": ["above_for_long_below_for_short", "outside_cloud", "none"]
        },
        "require_tk_state": {
          "enum": [
            "tenkan_over_kijun_for_long_under_for_short",
            "tk_cross_only",
            "none"
          ]
        },
        "require_chikou_confirmation": {
          "type": "boolean"
        },
        "chikou_mode": {
          "enum": ["close", "strict"]
        },
        "confirm_symbol": {
          "type": "string",
          "minLength": 1
        },
        "require_confirm_same_bar": {
          "type": "boolean",
          "default": false
        },
        "require_kijun_dip_setup": {
          "type": "boolean",
          "default": false
        },
        "require_cloud_color_align": {
          "type": "boolean",
          "default": false
        },
        "setup_bars": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependentRequired": {
        "confirm_symbol": ["require_confirm_same_bar"],
        "require_confirm_same_bar": ["confirm_symbol"]
      }
    },
    "exit_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "close_on_flat", "close_on_opposite", "max_bars_in_trade"],
      "properties": {
        "mode": {
          "enum": [
            "bias_flip",
            "flat_on_rule_fail",
            "opposite_signal",
            "time_stop",
            "regime_exit",
            "kijun_trail",
            "atr_stop",
            "chandelier_trail"
          ]
        },
        "close_on_flat": {
          "type": "boolean"
        },
        "close_on_opposite": {
          "type": "boolean"
        },
        "max_bars_in_trade": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "kijun_period": {
          "type": "integer",
          "minimum": 1
        },
        "atr_period": {
          "type": "integer",
          "minimum": 1,
          "default": 14
        },
        "atr_mult": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3.0
        },
        "chandelier_period": {
          "type": "integer",
          "minimum": 1,
          "default": 22
        }
      }
    },
    "regime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "params"],
      "properties": {
        "type": {
          "enum": ["adx", "er", "cloud_thickness", "none"]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "kill_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_dd_points",
        "min_trades",
        "must_beat_baseline",
        "baseline_metric",
        "notes"
      ],
      "properties": {
        "max_dd_points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_trades": {
          "type": "integer",
          "minimum": 1
        },
        "must_beat_baseline": {
          "type": "boolean"
        },
        "baseline_metric": {
          "enum": [
            "total_pnl_points",
            "total_pnl_points_after_fees",
            "max_drawdown_points",
            "win_rate",
            "profit_factor",
            "atr_normalized_total_return"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
